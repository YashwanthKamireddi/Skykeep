<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of Skykeep's leaves the phone through Android's backup or a phone-to-phone transfer:
  the library holds a person's notes, reminders and file lists, and is always read again from
  iCloud after signing in on the new phone. Excluding every domain covers both routes on
  Android 12 and later; allowBackup="false" and backup_rules.xml cover older versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
