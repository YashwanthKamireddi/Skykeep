<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the network is metered (photo backup waits for Wi-Fi) and whether the phone is
         online (Home says so calmly). A normal permission, granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- iCloud contacts and calendars kept in Android's own Contacts and Calendar. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />
    <!-- Reminders' alerts at their time (ReminderAlerts.kt), and set again after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- New photos backed up to iCloud Photos, only when turned on in Settings (PhotoBackup.kt). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Where each backed-up photo was taken: without it Android removes the location from what
         the app reads, and the photo would reach iCloud without it. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Send to iPhone on Android 14 and later: a user-initiated data transfer job, which the
         person starts from the Share sheet and can stop from the Task Manager (SendToIphone.kt). -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!-- Only before Android 14 (Send to iPhone) and before Android 12 (a sync asked for now):
         WorkManager runs that work as a foreground service of the data sync type, with its
         notification showing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Skykeep">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Send to iPhone: in every app's Share sheet, for any file. -->
        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:label="@string/send_to_iphone"
            android:theme="@style/Theme.Skykeep.Share"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The Skykeep account in Settings › Accounts. -->
        <service android:name=".sync.AuthenticatorService" android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>
        <service android:name=".sync.ContactsSyncService" android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_contacts" />
            <meta-data android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/contacts" />
        </service>
        <!-- Reminders, synced with the account like Contacts and Calendar (RemindersSync.kt). -->
        <provider android:name=".sync.RemindersProvider"
            android:authorities="${applicationId}.reminders"
            android:exported="false" android:syncable="true" />
        <service android:name=".sync.RemindersSyncService" android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_reminders" />
        </service>
        <!-- Notes, synced with the account the same way (NotesSync.kt). -->
        <provider android:name=".sync.NotesProvider"
            android:authorities="${applicationId}.notes"
            android:exported="false" android:syncable="true" />
        <service android:name=".sync.NotesSyncService" android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_notes" />
        </service>
        <!-- Photos, synced with the account the same way (PhotosSync.kt). -->
        <provider android:name=".sync.PhotosProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false" android:syncable="true" />
        <service android:name=".sync.PhotosSyncService" android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_photos" />
        </service>
        <!-- iCloud Drive in the Files app and every app's pickers (DriveProvider.kt). Only the
             system's document UI may call it (MANAGE_DOCUMENTS). -->
        <!-- Photos shared from Skykeep: the receiving app is granted that one copy, for that share. -->
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
        </provider>
        <provider android:name=".sync.DriveProvider"
            android:authorities="${applicationId}.drive"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- Send to iPhone's job on Android 14 and later (SendToIphone.kt). -->
        <service android:name=".sync.SendJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <!-- WorkManager's foreground service, declared as the data transfer it runs. -->
        <service android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <receiver android:name=".sync.ReminderAlertReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name=".sync.CalendarSyncService" android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_calendar" />
        </service>
    </application>

</manifest>
