# Every file this repository publishes, as extended regular expressions (whole path). A tracked
# file matching none of these fails CI, the local gate (check.sh) and the release: a broad
# `git add` once published another app's installer (install-arch.sh) and every local note in
# docs/. Add a line here only for something meant to be public.
\.github/.*
\.copr/.*
\.uiverify/.*\.(mjs|py|sh|webm)
probe/(Cargo\.toml|src/.*|examples/.*\.rs)
src/.*
src-tauri/.*
crates/.*
packaging/.*
snap/.*
docs/media/.*
(\.gitignore|\.gitleaks\.toml|\.gitleaksignore)
(ARCHITECTURE|README|SECURITY|PRIVACY)\.md
LICENSE
(Cargo\.toml|Cargo\.lock|rust-toolchain\.toml|about\.toml|deny\.toml)
(package\.json|package-lock\.json|tsconfig\.json|vite\.config\.ts|index\.html)
(check\.sh|run\.sh)
scripts/.*\.mjs
\.config/nextest\.toml
android/.*
