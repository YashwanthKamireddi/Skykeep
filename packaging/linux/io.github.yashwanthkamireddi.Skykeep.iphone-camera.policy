<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- What the admin prompt says when Skykeep sets up the iPhone camera as a webcam
     (src-tauri/src/iphone.rs, packaging/linux/iphone-camera-setup). pkexec finds this action by
     the program's path below and shows its message in place of "run /bin/sh as the super user".
     An administrator's password each time, as pkexec asks for any program. -->
<policyconfig>
  <vendor>Skykeep</vendor>
  <vendor_url>https://github.com/YashwanthKamireddi/Skykeep</vendor_url>
  <icon_name>io.github.yashwanthkamireddi.Skykeep</icon_name>
  <action id="io.github.yashwanthkamireddi.Skykeep.iphone-camera">
    <description>Set up the iPhone camera as a webcam</description>
    <message>Skykeep wants to set up your iPhone camera as a webcam for every app. This writes v4l2loopback's two settings files and loads the module.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/skykeep/iphone-camera-setup</annotate>
  </action>
</policyconfig>
