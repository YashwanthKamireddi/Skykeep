<?xml version="1.0" encoding="utf-8"?>
<!--
  Skykeep as an MSIX package, for the Microsoft Store: filled in and packed by pack.ps1
  (.github/workflows/msix.yml). The double-underscored values are filled at pack time — the
  identity from Partner Center (Product identity), the version from tauri.conf.json.

  Seven Start-menu entries, as the .exe and the .msi make them (packaging/windows): Skykeep, and
  each app on its own, started with the same app argument as the shortcuts (uap10:Parameters,
  Windows 10 2004 and later). Each entry's Id is the
  AppUserModelID the installers use, so Windows knows it as `<family name>!<that ID>` and each
  app's window (src-tauri/src/taskbar.rs) is matched to its own entry. Never change an Id once
  published: Windows keeps pinned tiles by it.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop3="http://schemas.microsoft.com/appx/manifest/desktop/windows10/3"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap uap10 desktop desktop3 desktop4 desktop5 rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Skykeep</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Description>Your iCloud notes, reminders, calendar, contacts, Drive and photos, on this computer. Not affiliated with Apple.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="io.github.yashwanthkamireddi.Skykeep" Executable="skykeep.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Skykeep" Description="Your iCloud, on this computer" BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- iCloud Drive in File Explorer (crates/quince-vfs/src/cloud.rs): a cloud folder of the
             package's own, which Windows removes with it — undeclared, it stayed registered
             after uninstall (Microsoft Q&A 5551232). -->
        <desktop3:Extension Category="windows.cloudFiles">
          <!-- Thumbnails of photos not on this computer yet (crates/quince-thumbs). The schema
               wants the other handlers named too, in this order, and the context menu element
               present. Named handlers must be real classes: a CLSID registered nowhere left
               Explorer's status icons wrong (OtherSync's notes), so these name Skykeep's own
               class that offers nothing, and Explorer shows its own states. -->
          <desktop3:CloudFiles>
            <desktop3:CustomStateHandler Clsid="229ead8b-daf0-4cee-af79-c52b31c43c5f" />
            <desktop3:ThumbnailProviderHandler Clsid="4ee8b6ba-8522-41f1-a17e-19126a88c38e" />
            <desktop3:ExtendedPropertyHandler Clsid="229ead8b-daf0-4cee-af79-c52b31c43c5f" />
            <desktop3:BannersHandler Clsid="229ead8b-daf0-4cee-af79-c52b31c43c5f" />
            <desktop3:CloudFilesContextMenus />
          </desktop3:CloudFiles>
        </desktop3:Extension>
        <!-- Send to iPhone at the top of Windows 11's right-click menu, for files and folders
             (crates/quince-thumbs/src/menu.rs); an installed copy has Send to instead. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="SendToIphone" Clsid="9ece47db-eea3-4515-b644-4d7666ddf149" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="SendToIphone" Clsid="9ece47db-eea3-4515-b644-4d7666ddf149" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Skykeep for File Explorer">
              <com:Class Id="4ee8b6ba-8522-41f1-a17e-19126a88c38e" Path="quince_thumbs.dll" ThreadingModel="STA" />
              <com:Class Id="9ece47db-eea3-4515-b644-4d7666ddf149" Path="quince_thumbs.dll" ThreadingModel="STA" />
              <com:Class Id="229ead8b-daf0-4cee-af79-c52b31c43c5f" Path="quince_thumbs.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <!-- Open at Login: off until turned on in Settings (src-tauri/src/login.rs), then
             listed in Task Manager's Startup apps. Started hidden, as the Run key starts it. -->
        <desktop:Extension Category="windows.startupTask" Executable="skykeep.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--background">
          <desktop:StartupTask TaskId="SkykeepStartup" Enabled="false" DisplayName="Skykeep" />
        </desktop:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="icalendar">
            <uap:DisplayName>Calendar events</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="text/calendar">.ics</uap:FileType>
              <uap:FileType ContentType="text/calendar">.ical</uap:FileType>
              <uap:FileType ContentType="text/calendar">.icalendar</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="vcard">
            <uap:DisplayName>Contact card</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="text/vcard">.vcf</uap:FileType>
              <uap:FileType ContentType="text/vcard">.vcard</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>

    <Application Id="io.github.yashwanthkamireddi.Skykeep.Notes" Executable="skykeep.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--app notes">
      <uap:VisualElements DisplayName="Skykeep Notes" Description="Notes from iCloud, on this computer" BackgroundColor="transparent"
        Square150x150Logo="Assets\Notes\Square150x150Logo.png" Square44x44Logo="Assets\Notes\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Notes\Wide310x150Logo.png" Square71x71Logo="Assets\Notes\Square71x71Logo.png" Square310x310Logo="Assets\Notes\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>

    <Application Id="io.github.yashwanthkamireddi.Skykeep.Reminders" Executable="skykeep.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--app reminders">
      <uap:VisualElements DisplayName="Skykeep Reminders" Description="Reminders from iCloud, on this computer" BackgroundColor="transparent"
        Square150x150Logo="Assets\Reminders\Square150x150Logo.png" Square44x44Logo="Assets\Reminders\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Reminders\Wide310x150Logo.png" Square71x71Logo="Assets\Reminders\Square71x71Logo.png" Square310x310Logo="Assets\Reminders\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>

    <Application Id="io.github.yashwanthkamireddi.Skykeep.Calendar" Executable="skykeep.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--app calendar">
      <uap:VisualElements DisplayName="Skykeep Calendar" Description="Your iCloud calendars, on this computer" BackgroundColor="transparent"
        Square150x150Logo="Assets\Calendar\Square150x150Logo.png" Square44x44Logo="Assets\Calendar\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Calendar\Wide310x150Logo.png" Square71x71Logo="Assets\Calendar\Square71x71Logo.png" Square310x310Logo="Assets\Calendar\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>

    <Application Id="io.github.yashwanthkamireddi.Skykeep.Contacts" Executable="skykeep.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--app contacts">
      <uap:VisualElements DisplayName="Skykeep Contacts" Description="Your iCloud contacts, on this computer" BackgroundColor="transparent"
        Square150x150Logo="Assets\Contacts\Square150x150Logo.png" Square44x44Logo="Assets\Contacts\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Contacts\Wide310x150Logo.png" Square71x71Logo="Assets\Contacts\Square71x71Logo.png" Square310x310Logo="Assets\Contacts\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>

    <Application Id="io.github.yashwanthkamireddi.Skykeep.Drive" Executable="skykeep.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--app drive">
      <uap:VisualElements DisplayName="Skykeep Drive" Description="iCloud Drive, on this computer" BackgroundColor="transparent"
        Square150x150Logo="Assets\Drive\Square150x150Logo.png" Square44x44Logo="Assets\Drive\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Drive\Wide310x150Logo.png" Square71x71Logo="Assets\Drive\Square71x71Logo.png" Square310x310Logo="Assets\Drive\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>

    <Application Id="io.github.yashwanthkamireddi.Skykeep.Photos" Executable="skykeep.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--app photos">
      <uap:VisualElements DisplayName="Skykeep Photos" Description="iCloud Photos, on this computer" BackgroundColor="transparent"
        Square150x150Logo="Assets\Photos\Square150x150Logo.png" Square44x44Logo="Assets\Photos\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Photos\Wide310x150Logo.png" Square71x71Logo="Assets\Photos\Square71x71Logo.png" Square310x310Logo="Assets\Photos\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
