<?xml version="1.0" encoding="utf-8"?>
<!--
  Skykeep's six apps in the Start menu, from the MSI: what installer-hooks.nsh makes for the
  .exe installer. "Skykeep Notes" opens Notes on its own, as its Linux launcher entry does,
  beside Tauri's own "Skykeep" in the same Start-menu folder; each is stamped with its app's
  AppUserModelID (`<identifier>.Notes`, as its window says at runtime:
  src-tauri/src/taskbar.rs). One component, so the MSI takes all six away again on uninstall.

  Referenced from tauri.conf.json (bundle > windows > wix > fragmentPaths, componentRefs). The
  ids it uses are Tauri's main.wxs's own: ApplicationProgramsFolder (the Start-menu folder),
  Path (skykeep.exe), ProductIcon and INSTALLDIR.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Each app's own icon on its shortcut (packaging/icons/apps), found beside this file. -->
    <Icon Id="SkykeepNotesIcon" SourceFile="$(sys.SOURCEFILEDIR)..\icons\apps\notes.ico" />
    <Icon Id="SkykeepRemindersIcon" SourceFile="$(sys.SOURCEFILEDIR)..\icons\apps\reminders.ico" />
    <Icon Id="SkykeepCalendarIcon" SourceFile="$(sys.SOURCEFILEDIR)..\icons\apps\calendar.ico" />
    <Icon Id="SkykeepContactsIcon" SourceFile="$(sys.SOURCEFILEDIR)..\icons\apps\contacts.ico" />
    <Icon Id="SkykeepDriveIcon" SourceFile="$(sys.SOURCEFILEDIR)..\icons\apps\drive.ico" />
    <Icon Id="SkykeepPhotosIcon" SourceFile="$(sys.SOURCEFILEDIR)..\icons\apps\photos.ico" />
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="SkykeepAppShortcuts" Guid="*">
        <Shortcut Id="SkykeepNotesShortcut" Name="Skykeep Notes" Description="Notes from iCloud, on this computer"
                  Target="[!Path]" Arguments="--app notes" Icon="SkykeepNotesIcon" WorkingDirectory="INSTALLDIR">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="io.github.yashwanthkamireddi.Skykeep.Notes"/>
        </Shortcut>
        <Shortcut Id="SkykeepRemindersShortcut" Name="Skykeep Reminders" Description="Reminders from iCloud, on this computer"
                  Target="[!Path]" Arguments="--app reminders" Icon="SkykeepRemindersIcon" WorkingDirectory="INSTALLDIR">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="io.github.yashwanthkamireddi.Skykeep.Reminders"/>
        </Shortcut>
        <Shortcut Id="SkykeepCalendarShortcut" Name="Skykeep Calendar" Description="Your iCloud calendars, on this computer"
                  Target="[!Path]" Arguments="--app calendar" Icon="SkykeepCalendarIcon" WorkingDirectory="INSTALLDIR">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="io.github.yashwanthkamireddi.Skykeep.Calendar"/>
        </Shortcut>
        <Shortcut Id="SkykeepContactsShortcut" Name="Skykeep Contacts" Description="Your iCloud contacts, on this computer"
                  Target="[!Path]" Arguments="--app contacts" Icon="SkykeepContactsIcon" WorkingDirectory="INSTALLDIR">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="io.github.yashwanthkamireddi.Skykeep.Contacts"/>
        </Shortcut>
        <Shortcut Id="SkykeepDriveShortcut" Name="Skykeep Drive" Description="iCloud Drive, on this computer"
                  Target="[!Path]" Arguments="--app drive" Icon="SkykeepDriveIcon" WorkingDirectory="INSTALLDIR">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="io.github.yashwanthkamireddi.Skykeep.Drive"/>
        </Shortcut>
        <Shortcut Id="SkykeepPhotosShortcut" Name="Skykeep Photos" Description="iCloud Photos, on this computer"
                  Target="[!Path]" Arguments="--app photos" Icon="SkykeepPhotosIcon" WorkingDirectory="INSTALLDIR">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="io.github.yashwanthkamireddi.Skykeep.Photos"/>
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Yashwanth Kamireddi\Skykeep" Name="App Shortcuts" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    <!-- Send to → iPhone (Skykeep): Skykeep keeps it in the Send To folder itself
         (src-tauri/src/send.rs); the MSI takes it away on uninstall, as the .exe's does. -->
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="SendToFolder" />
    </DirectoryRef>
    <DirectoryRef Id="SendToFolder">
      <Component Id="SkykeepSendTo" Guid="*">
        <RemoveFile Id="SkykeepSendToEntry" Name="iPhone (Skykeep).lnk" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\Yashwanth Kamireddi\Skykeep" Name="Send To" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
