# One of Skykeep's six apps, on its own in the launcher. Its window says this file's name as
# its app ID (src-tauri/src/apps.rs), so a dock shows it as this app. All six run in one
# Skykeep: one sign-in, one library.
[Desktop Entry]
Type=Application
Name=Photos
GenericName=Photos for iCloud
Comment=iCloud Photos, on this computer
Exec=skykeep --app photos
Icon=io.github.yashwanthkamireddi.Skykeep.Photos
Terminal=false
Categories=Office;
Keywords=Skykeep;iCloud;pictures;images;gallery;
StartupNotify=true
StartupWMClass=io.github.yashwanthkamireddi.Skykeep.Photos
