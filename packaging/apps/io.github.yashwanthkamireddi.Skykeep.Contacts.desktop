# One of Skykeep's six apps, on its own in the launcher. Its window says this file's name as
# its app ID (src-tauri/src/apps.rs), so a dock shows it as this app. All six run in one
# Skykeep: one sign-in, one library.
[Desktop Entry]
Type=Application
Name=Contacts
GenericName=Contacts for iCloud
Comment=Your iCloud contacts, on this computer
Exec=skykeep --app contacts
Icon=io.github.yashwanthkamireddi.Skykeep.Contacts
Terminal=false
Categories=Office;
Keywords=Skykeep;iCloud;people;address;
StartupNotify=true
StartupWMClass=io.github.yashwanthkamireddi.Skykeep.Contacts
