# One of Skykeep's six apps, on its own in the launcher. Its window says this file's name as
# its app ID (src-tauri/src/apps.rs), so a dock shows it as this app. All six run in one
# Skykeep: one sign-in, one library. Named "Skykeep Reminders", as its Start-menu shortcut is, so it
# is never mistaken for the desktop's own Reminders app.
[Desktop Entry]
Type=Application
Name=Skykeep Reminders
GenericName=Reminders for iCloud
Comment=Reminders from iCloud, on this computer
Exec=skykeep --app reminders
Icon=io.github.yashwanthkamireddi.Skykeep.Reminders
Terminal=false
Categories=Office;
Keywords=Skykeep;iCloud;todo;tasks;lists;
StartupNotify=true
Actions=new-reminder;
StartupWMClass=io.github.yashwanthkamireddi.Skykeep.Reminders

# A quick capture: one field, Enter, and it is in iCloud (src-tauri/src/intake.rs).
[Desktop Action new-reminder]
Name=New Reminder
Exec=skykeep --new reminder
