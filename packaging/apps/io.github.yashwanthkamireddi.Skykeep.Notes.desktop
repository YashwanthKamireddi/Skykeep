# One of Skykeep's six apps, on its own in the launcher. Its window says this file's name as
# its app ID (src-tauri/src/apps.rs), so a dock shows it as this app. All six run in one
# Skykeep: one sign-in, one library.
[Desktop Entry]
Type=Application
Name=Notes
GenericName=Notes for iCloud
Comment=Notes from iCloud, on this computer
Exec=skykeep --app notes
Icon=io.github.yashwanthkamireddi.Skykeep.Notes
Terminal=false
Categories=Office;
Keywords=Skykeep;iCloud;notes;memo;
StartupNotify=true
Actions=new-note;
StartupWMClass=io.github.yashwanthkamireddi.Skykeep.Notes

# A quick capture: one field, Enter, and it is in iCloud (src-tauri/src/intake.rs).
[Desktop Action new-note]
Name=New Note
Exec=skykeep --new note
